{
  "name": "steam/search",
  "display_name": "Steam Search",
  "type": "api",
  "vendor": "Steam",
  "vendor_slug": "steam",
  "description": "Search the Steam store by keyword and get games and apps with app ID, title, price, discount, release date and review summary.",
  "tags": [
    "api",
    "steam",
    "games",
    "product-data"
  ],
  "capabilities": [
    "api",
    "steam",
    "games",
    "product-data"
  ],
  "modes": [
    "async"
  ],
  "default_mode": "async",
  "endpoints": {
    "run": "POST /v1/run",
    "get_run": "GET /v1/run/{id}",
    "passthrough": "POST /v1/api/steam/search"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "q"
    ],
    "properties": {
      "q": {
        "type": "string",
        "example": "portal",
        "maxLength": 500,
        "minLength": 1,
        "description": "Game or software title to search for."
      },
      "country": {
        "type": "string",
        "pattern": "^[A-Za-z]{2}$",
        "description": "Two-letter country code for prices and availability."
      },
      "timeout": {
        "type": "number",
        "default": 50,
        "maximum": 50,
        "description": "Seconds the data source may spend before giving up (max 50, default 50). A timed-out call is not billed.",
        "exclusiveMinimum": 0
      },
      "language": {
        "type": "string",
        "pattern": "^[a-z]{2,30}$",
        "description": "Steam language name, such as english, german, or french."
      }
    }
  },
  "response_schema": {
    "type": "object",
    "required": [
      "id",
      "status",
      "model"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "model": {
        "type": "string"
      },
      "status": {
        "type": "string"
      }
    }
  },
  "pricing": {
    "currency": "USD",
    "model": "per_call",
    "per_call": 0.00015
  },
  "readme": "# Steam Search\n\nSearch the Steam store by keyword and get games and apps with app ID, title, price, discount, release date and review summary.",
  "page_url": "https://www.sandbase.ai/model/steam/search",
  "created_at": "2026-11-13T04:23:54.153Z"
}
