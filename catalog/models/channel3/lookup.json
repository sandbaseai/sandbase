    ],
    "properties": {
      "url": {
        "type": "string",
        "format": "uri",
        "example": "https://www.nike.com/t/air-force-1-07-mens-shoes-jBrhbr/CW2288-111",
        "description": "Retailer product-page URL to resolve."
      },
      "realtime_fetch": {
        "type": "boolean",
