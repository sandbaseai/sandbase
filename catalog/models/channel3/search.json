    "properties": {
      "id": {
        "type": "string"
      },
      "model": {
        "type": "string"
      },
      "status": {
        "type": "string"
      }
    }
  },
  "pricing": {
    "currency": "USD",
    "model": "per_call",
    "per_call": 0.007
