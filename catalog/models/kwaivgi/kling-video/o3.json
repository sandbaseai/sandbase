    "formula": "(params.resolution ?? \"standard\") == \"4k\" ? (params.duration ?? 5) * 0.42 : ((params.video ?? \"\") != \"\" ? ((params.resolution ?? \"standard\") == \"pro\" ? (params.duration ?? 5) * 0.168 : (params.duration ?? 5) * 0.126) : ((params.resolution ?? \"standard\") == \"pro\" ? ((params.generate_audio ?? true) == false ? (params.duration ?? 5) * 0.112 : (params.duration ?? 5) * 0.14) : ((params.generate_audio ?? true) == false ? (params.duration ?? 5) * 0.084 : (params.duration ?? 5) * 0.112)))",
    "formula_variables": [
