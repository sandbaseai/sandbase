    "structured_output",
    "function_calling"
  ],
  "capabilities": [
    "chat",
    "reasoning",
    "structured_output",
    "function_calling"
  ],
  "modes": [
    "sync"
  ],
  "default_mode": "sync",
  "endpoints": {
    "chat_completions": "POST /v1/chat/completions",
    "responses": "POST /v1/responses",
    "messages": "POST /v1/messages"
  },
  "pricing": {
    "currency": "USD",
    "model": "per_token",
    "per_million_tokens": {
      "input": 0.18,
      "output": 0.7,
      "cache_read_multiplier": 1
    },
    "formula": "usage.reasoning_tokens > 0 ? (usage.prompt_tokens * 0.18 / 1000000 + usage.completion_tokens * 2.1 / 1000000) : (usage.prompt_tokens * 0.18 / 1000000 + usage.completion_tokens * 0.7 / 1000000)",
    "formula_variables": [
      "usage.completion_tokens",
      "usage.prompt_tokens",
      "usage.reasoning_tokens"
    ]
  },
