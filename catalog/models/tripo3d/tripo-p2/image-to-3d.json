        "title": "PBR",
        "default": true,
        "description": "Generate PBR materials (also enables texture)."
      },
      "quad": {
        "type": "boolean",
        "title": "Quad Mesh",
        "default": false,
        "description": "Generate quad mesh topology instead of triangles."
      },
      "seed": {
        "type": "integer",
        "title": "Seed",
        "description": "Seed for reproducible geometry generation."
      },
      "image": {
        "type": "string",
        "title": "Image",
        "description": "Input image URL for 3D model creation."
      },
      "texture": {
        "type": "boolean",
        "title": "Texture",
        "default": true,
        "description": "Generate textures. Set both texture and pbr to false for an untextured model."
      },
      "face_limit": {
        "type": "integer",
        "title": "Face Limit",
        "maximum": 50000,
        "minimum": 48,
        "description": "Maximum faces (quad meshes up to 25,000)."
      },
      "texture_quality": {
        "enum": [
          "fast",
          "standard",
          "detailed",
          "extreme"
        ],
        "type": "string",
        "title": "Texture Quality",
        "default": "standard",
        "description": "Texture quality tier."
      }
    }
  },
  "response_schema": {
    "type": "object",
    "title": "GenerationResponse",
    "required": [
      "id",
      "status"
    ],
    "properties": {
