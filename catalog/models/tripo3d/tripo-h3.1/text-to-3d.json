{
  "name": "tripo3d/tripo-h3.1/text-to-3d",
  "display_name": "Tripo H3.1 Text to 3D",
  "type": "image",
  "vendor": "Tripo3D",
  "vendor_slug": "tripo3d",
  "description": "Tripo H3.1 is Tripo3D's text-to-3D AI model. Turn written descriptions into textured 3D objects with realistic geometry and materials.",
  "tags": [
    "text-to-3d"
  ],
  "capabilities": [
    "text-to-3d"
  ],
  "modes": [
    "async"
  ],
  "default_mode": "async",
  "endpoints": {
    "run": "POST /v1/run",
    "get_run": "GET /v1/run/{id}"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "prompt"
    ],
    "properties": {
      "pbr": {
        "type": "boolean",
        "title": "PBR",
        "default": true,
        "description": "Generate PBR materials (also enables texture)."
      },
      "quad": {
        "type": "boolean",
        "title": "Quad Mesh",
        "default": false,
        "description": "Generate quad mesh topology instead of triangles."
      },
      "seed": {
        "type": "integer",
        "title": "Seed",
        "description": "Seed for reproducible geometry generation."
      },
      "prompt": {
        "type": "string",
        "title": "Prompt",
        "examples": [
          "A small house with a red roof and white walls"
        ],
        "maxLength": 1024,
        "description": "Text description of the 3D object to generate. Maximum 1024 characters."
      },
      "texture": {
        "type": "boolean",
        "title": "Texture",
        "default": true,
        "description": "Generate textures. Set both texture and pbr to false for an untextured model."
      },
      "face_limit": {
        "type": "integer",
        "title": "Face Limit",
        "maximum": 2000000,
        "minimum": 1000,
        "description": "Target face count. Adaptive when unset."
      },
      "negative_prompt": {
        "type": "string",
        "title": "Negative Prompt",
        "description": "Features to avoid in the generated model."
      },
      "texture_quality": {
        "enum": [
          "standard",
          "detailed"
        ],
        "type": "string",
        "title": "Texture Quality",
        "default": "standard",
        "description": "standard or detailed (HD) textures."
      },
      "geometry_quality": {
        "enum": [
          "standard",
          "detailed"
        ],
        "type": "string",
        "title": "Geometry Quality",
        "default": "standard",
        "description": "detailed geometry is billed as an add-on."
      }
    }
  },
  "response_schema": {
    "type": "object",
    "title": "GenerationResponse",
    "required": [
      "id",
      "status"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier for the generation task."
      },
      "error": {
        "type": "string",
        "description": "Error message if the task failed. Empty on success."
      },
      "model": {
        "type": "string",
        "description": "Model ID used for the prediction."
      },
      "status": {
        "enum": [
          "pending",
          "running",
          "completed",
          "failed",
          "timeout"
        ],
        "type": "string",
        "description": "Status of the task: pending, running, completed, failed, or timeout."
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "title": "OutputItem",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "description": "The URL where the generated content can be downloaded from."
            },
            "content_type": {
              "type": "string",
              "description": "The MIME type of the output file."
            }
          }
        },
        "description": "Array of generated content. Empty when status is not completed."
      }
    }
  },
  "pricing": {
    "currency": "USD",
    "model": "formula",
    "formula": "(((params.texture ?? true) || (params.pbr ?? true)) ? ((params.texture_quality ?? \"standard\") == \"detailed\" ? 0.36 : 0.24) : 0.12) + ((params.geometry_quality ?? \"standard\") == \"detailed\" ? 0.24 : 0.0) + ((params.quad ?? false) ? 0.06 : 0.0)",
    "formula_variables": [
      "params.geometry_quality",
      "params.pbr",
      "params.quad",
      "params.texture",
      "params.texture_quality"
    ],
    "reference_price": 0.24,
