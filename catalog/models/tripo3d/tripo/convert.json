{
  "name": "tripo3d/tripo/convert",
  "display_name": "Tripo Convert",
  "type": "image",
  "vendor": "Tripo3D",
  "vendor_slug": "tripo3d",
  "description": "Tripo Convert exports a 3D model to GLTF, FBX, USDZ, OBJ, STL or 3MF, with optional quad remesh, scaling and texture settings.",
  "tags": [
    "3d-to-3d"
  ],
  "capabilities": [
    "3d-to-3d"
  ],
  "modes": [
    "async"
  ],
  "default_mode": "async",
  "endpoints": {
    "run": "POST /v1/run",
    "get_run": "GET /v1/run/{id}"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "model_url",
      "format"
    ],
    "properties": {
      "bake": {
        "type": "boolean",
        "title": "Bake",
        "default": true,
        "description": "Bake advanced materials into the textures."
      },
      "quad": {
        "type": "boolean",
        "title": "Quad",
        "default": false,
        "description": "Quad remesh (10,000 faces when face_limit is unset). Forces FBX."
      },
      "format": {
        "enum": [
          "GLTF",
          "FBX",
          "USDZ",
          "OBJ",
          "STL",
          "3MF"
        ],
        "type": "string",
        "title": "Format",
        "default": "FBX",
        "examples": [
          "FBX"
        ],
        "description": "Output format."
      },
      "pack_uv": {
        "type": "boolean",
        "title": "Pack UV",
        "default": false,
        "description": "Pack all UV islands into one texture."
      },
      "model_url": {
        "type": "string",
        "title": "Model URL",
        "examples": [
          "https://static.sandbase.ai/examples/tripo3d/tripo/shared/object.glb"
        ],
        "description": "URL of the input 3D model (GLB, GLTF, FBX, OBJ or STL, up to 150 MB)."
      },
      "face_limit": {
        "type": "integer",
        "title": "Face Limit",
        "minimum": 1,
        "description": "Target face count. Original when unset."
      },
      "fbx_preset": {
        "enum": [
          "blender",
          "3dsmax",
          "mixamo",
          "bake_scale"
        ],
        "type": "string",
        "title": "FBX Preset",
        "default": "blender",
        "description": "FBX target application."
      },
      "part_names": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "title": "Part Names",
        "description": "Only process these parts (node names from a segmentation, e.g. tripo_part_0). All parts when unset."
      },
      "scale_factor": {
        "type": "number",
        "title": "Scale Factor",
        "default": 1,
        "description": "Uniform scale."
      },
      "texture_size": {
        "type": "integer",
        "title": "Texture Size",
        "default": 4096,
        "description": "Texture size in pixels."
      },
      "flatten_bottom": {
        "type": "boolean",
        "title": "Flatten Bottom",
        "default": false,
        "description": "Flatten the bottom of the model."
      },
      "force_symmetry": {
        "type": "boolean",
        "title": "Force Symmetry",
        "default": false,
        "description": "Symmetric quad mesh. Only with quad."
      },
      "texture_format": {
        "enum": [
          "JPEG",
          "PNG",
          "WEBP",
          "BMP",
          "DPX",
          "HDR",
          "OPEN_EXR",
          "TARGA",
          "TIFF"
        ],
        "type": "string",
        "title": "Texture Format",
        "default": "JPEG",
        "description": "Texture image format."
      },
      "with_animation": {
        "type": "boolean",
        "title": "With Animation",
        "default": true,
        "description": "Keep animations."
      },
      "animate_in_place": {
        "type": "boolean",
        "title": "Animate in Place",
        "default": false,
        "description": "Remove root motion from animations."
      },
      "texture_packaging": {
        "enum": [
          "embedded",
          "zip"
        ],
        "type": "string",
        "title": "Texture Packaging",
        "default": "embedded",
        "description": "FBX only: embedded textures, or a zip with the FBX and a .fbm folder."
      },
      "export_orientation": {
        "enum": [
          "+x",
          "-x",
          "+y",
          "-y"
        ],
        "type": "string",
        "title": "Export Orientation",
        "description": "Forward axis of the exported model."
      },
      "export_vertex_colors": {
        "type": "boolean",
        "title": "Export Vertex Colors",
        "default": false,
        "description": "Vertex colors (OBJ and GLTF only)."
      },
      "pivot_to_center_bottom": {
        "type": "boolean",
        "title": "Pivot to Center Bottom",
        "default": false,
        "description": "Move the pivot to the bottom center."
      },
      "flatten_bottom_threshold": {
        "type": "number",
        "title": "Flatten Bottom Threshold",
        "default": 0.01,
        "description": "Depth flattened when flatten_bottom is on."
      }
    }
  },
  "response_schema": {
    "type": "object",
    "title": "GenerationResponse",
    "required": [
      "id",
      "status"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier for the generation task."
      },
      "error": {
        "type": "string",
        "description": "Error message if the task failed. Empty on success."
      },
      "model": {
        "type": "string",
        "description": "Model ID used for the prediction."
      },
      "status": {
        "enum": [
          "pending",
          "running",
          "completed",
          "failed",
          "timeout"
        ],
        "type": "string",
        "description": "Status of the task: pending, running, completed, failed, or timeout."
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "title": "OutputItem",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "description": "The URL where the generated content can be downloaded from."
            },
            "content_type": {
              "type": "string",
              "description": "The MIME type of the output file."
            }
          }
        },
        "description": "Array of generated content. Empty when status is not completed."
      }
    }
  },
  "pricing": {
    "currency": "USD",
    "model": "formula",
    "formula": "((params.quad ?? false) || (params.face_limit ?? 0) > 0 || (params.flatten_bottom ?? false) || (params.flatten_bottom_threshold ?? 0.01) != 0.01 || (params.texture_size ?? 4096) != 4096 || (params.texture_format ?? \"JPEG\") != \"JPEG\" || (params.pivot_to_center_bottom ?? false) || (params.scale_factor ?? 1) != 1) ? 0.10 : 0.05",
    "formula_variables": [
      "params.face_limit",
      "params.flatten_bottom",
      "params.flatten_bottom_threshold",
      "params.pivot_to_center_bottom",
      "params.quad",
      "params.scale_factor",
      "params.texture_format",
      "params.texture_size"
    ],
    "reference_price": 0.05,
