{
  "name": "pixverse/v6/image-to-video",
  "display_name": "PixVerse V6 Image to Video",
  "type": "video",
  "vendor": "PixVerse",
  "vendor_slug": "pixverse",
  "description": "V6 is PixVerse's image-to-video AI model. Bring static images to life with fluid animation, consistent character motion, and professional-grade video output.",
  "tags": [
    "image-to-video"
  ],
  "capabilities": [
    "image-to-video"
  ],
  "modes": [
    "async"
  ],
  "default_mode": "async",
  "endpoints": {
    "run": "POST /v1/run",
    "get_run": "GET /v1/run/{id}"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "prompt",
      "image"
    ],
    "properties": {
      "seed": {
        "type": "integer",
        "title": "Seed",
        "description": "\n            The same seed and the same prompt given to the same version of the model\n            will output the same video every time.\n        "
      },
      "image": {
        "type": "string",
        "title": "Image Url",
        "examples": [
          "https://static.sandbase.ai/examples/pixverse/v6/image-to-video/output_url_0.png"
        ],
        "description": "URL of the image to use as the first frame"
      },
      "style": {
        "enum": [
          "anime",
          "3d_animation",
          "clay",
          "comic",
          "cyberpunk"
        ],
        "type": "string",
        "title": "Style",
        "description": "The style of the generated video"
      },
      "prompt": {
        "type": "string",
        "title": "Prompt",
        "examples": [
          "A woman warrior with her hammer walking with his glacier wolf."
        ]
      },
      "duration": {
        "type": "integer",
        "title": "Duration",
        "default": 5,
        "maximum": 15,
        "minimum": 1,
        "description": "The duration of the generated video in seconds. v6 supports values from 1 to 15 seconds"
      },
      "resolution": {
        "enum": [
          "360p",
          "540p",
          "720p",
          "1080p"
        ],
        "type": "string",
        "title": "Resolution",
        "default": "720p",
        "description": "The resolution of the generated video"
      },
      "generate_audio_switch": {
        "type": "boolean",
        "title": "Generate Audio Switch",
        "default": false,
        "description": "Enable audio generation (BGM, SFX, dialogue)"
      }
    }
  },
  "response_schema": {
    "type": "object",
    "title": "GenerationResponse",
    "required": [
      "id",
      "status"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier for the generation task."
      },
      "error": {
        "type": "string",
        "description": "Error message if the task failed. Empty on success."
      },
      "model": {
        "type": "string",
        "description": "Model ID used for the prediction."
      },
      "status": {
        "enum": [
          "pending",
          "running",
          "completed",
          "failed",
          "timeout"
        ],
        "type": "string",
        "description": "Status of the task: pending, running, completed, failed, or timeout."
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "title": "OutputItem",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "examples": [
                "https://static.sandbase.ai/examples/pixverse/v6/image-to-video/output_url_1.mp4"
              ],
              "description": "The URL where the generated content can be downloaded from."
            },
            "content_type": {
              "type": "string",
              "description": "The MIME type of the output file."
            }
          }
        },
        "description": "Array of generated content. Empty when status is not completed."
      }
    }
  },
  "pricing": {
    "currency": "USD",
    "model": "formula",
    "formula": "(params.resolution ?? \"720p\") == \"1080p\" ? ((params.generate_audio_switch ?? false) ? (params.duration ?? 5) * 0.115 : (params.duration ?? 5) * 0.090) : (params.resolution ?? \"720p\") == \"720p\" ? ((params.generate_audio_switch ?? false) ? (params.duration ?? 5) * 0.060 : (params.duration ?? 5) * 0.045) : (params.resolution ?? \"720p\") == \"540p\" ? ((params.generate_audio_switch ?? false) ? (params.duration ?? 5) * 0.045 : (params.duration ?? 5) * 0.035) : ((params.generate_audio_switch ?? false) ? (params.duration ?? 5) * 0.035 : (params.duration ?? 5) * 0.025)",
