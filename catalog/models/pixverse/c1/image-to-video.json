    "model": "formula",
    "formula": "(params.resolution ?? \"720p\") == \"1080p\" ? ((params.generate_audio_switch ?? false) ? (params.duration ?? 5) * 0.120 : (params.duration ?? 5) * 0.095) : (params.resolution ?? \"720p\") == \"720p\" ? ((params.generate_audio_switch ?? false) ? (params.duration ?? 5) * 0.065 : (params.duration ?? 5) * 0.050) : (params.resolution ?? \"720p\") == \"540p\" ? ((params.generate_audio_switch ?? false) ? (params.duration ?? 5) * 0.050 : (params.duration ?? 5) * 0.040) : ((params.generate_audio_switch ?? false) ? (params.duration ?? 5) * 0.040 : (params.duration ?? 5) * 0.030)",
