{
  "name": "sandai/magi-2/reference-to-video",
  "display_name": "MAGI-2 Reference to Video",
  "type": "video",
  "vendor": "Sand AI",
  "vendor_slug": "sandai",
  "description": "MAGI-2 by Sand AI creates a 1080p video of 4 to 30 seconds with native audio, guided by up to 10 reference images, 5 video clips and 5 audio clips.",
  "tags": [
    "reference-to-video"
  ],
  "capabilities": [
    "reference-to-video"
  ],
  "modes": [
    "async"
  ],
  "default_mode": "async",
  "endpoints": {
    "run": "POST /v1/run",
    "get_run": "GET /v1/run/{id}"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "prompt"
    ],
    "properties": {
      "seed": {
        "type": "integer",
        "title": "Seed",
        "maximum": 4294967295,
        "minimum": 0,
        "description": "Random seed for reproducibility (0-4294967295). Omit for a random seed."
      },
      "audios": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "title": "Reference Audio",
        "maxItems": 5,
        "description": "Up to 5 WAV/MP3 URLs, 2-30 s each and 30 s in total, up to 15 MB each."
      },
      "images": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "title": "Reference Images",
        "maxItems": 10,
        "description": "Up to 10 public HTTPS image URLs, each under 30 MB."
      },
      "prompt": {
        "type": "string",
        "title": "Prompt",
        "description": "Describe how to use the references, the scene, motion and sound."
      },
      "videos": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "title": "Reference Videos",
        "maxItems": 5,
        "description": "Up to 5 MP4/MOV URLs, 2-30 s each and 30 s in total, up to 200 MB each."
      },
      "duration": {
        "type": "integer",
        "title": "Duration",
        "default": 5,
        "maximum": 30,
        "minimum": 4,
        "examples": [
          5,
          10,
          30
        ],
        "description": "Output video duration in seconds (4-30). Billed per second."
      },
      "resolution": {
        "enum": [
          "1080p"
        ],
        "type": "string",
        "title": "Resolution",
        "default": "1080p",
        "description": "Output resolution. MAGI-2 renders 1080p only."
      },
      "aspect_ratio": {
        "enum": [
          "16:9",
          "9:16",
          "1:1",
          "4:3",
          "3:4",
          "21:9"
        ],
        "type": "string",
        "title": "Aspect Ratio",
        "default": "16:9",
        "description": "Output aspect ratio."
      },
      "generate_audio": {
        "type": "boolean",
        "title": "Generate Audio",
        "default": true,
        "description": "Generate a native audio track with the video. Included in the price."
      }
    }
  },
  "response_schema": {
    "type": "object",
    "title": "GenerationResponse",
    "required": [
      "id",
      "status"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier for the generation task."
      },
      "error": {
        "type": "string",
        "description": "Error message if the task failed. Empty on success."
      },
      "model": {
        "type": "string",
        "description": "Model ID used for the prediction."
      },
      "status": {
        "enum": [
          "pending",
          "running",
          "completed",
          "failed",
          "timeout"
        ],
        "type": "string",
        "description": "Status of the task: pending, running, completed, failed, or timeout."
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "title": "OutputItem",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "description": "The URL where the generated content can be downloaded from."
            },
            "content_type": {
              "type": "string",
              "description": "The MIME type of the output file."
            }
          }
        },
        "description": "Array of generated content. Empty when status is not completed."
      }
    }
  },
  "pricing": {
    "currency": "USD",
    "model": "formula",
    "formula": "(params.duration ?? 5) * 0.08",
    "formula_variables": [
      "params.duration"
    ],
    "reference_price": 0.4,
    "price_examples": [
      {
        "params": {
          "duration": 4
        },
        "usd": 0.32
      },
      {
        "params": {
          "duration": 5
        },
        "usd": 0.4
      },
      {
        "params": {
          "duration": 30
        },
        "usd": 2.4
      }
    ]
  },
  "examples": [
    {
