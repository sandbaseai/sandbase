        "aspect_ratio": "16:9",
        "duration": 5,
        "images": [
          "https://static.sandbase.ai/examples/eeb92b90-3c1a-4979-9860-1c508e732417/input/776a14fa-b948-478b-bae6-a45c68da5ac7.jpg",
          "https://static.sandbase.ai/examples/eeb92b90-3c1a-4979-9860-1c508e732417/input/e53fed62-fd62-44db-a206-3cf944d6d8e8.webp"
        ],
        "prompt": "The pink-haired basketball player in the blue jersey from image 2 walks into the jazz bar from image 1 and dances in front of the band while the camera tracks alongside."
      },
      "output": [
        {
          "url": "https://static.sandbase.ai/examples/eeb92b90-3c1a-4979-9860-1c508e732417/output/d2d4c16f-12c5-4149-9204-87f8ceb701cb.mp4"
        }
      ],
      "default": true
    },
    {
      "input": {
        "aspect_ratio": "16:9",
        "duration": 5,
        "prompt": "Use the slow forward camera move from video 1 at a frozen mountain lake at sunrise, thin mist drifting over the ice and snowy peaks behind.",
        "videos": [
          "https://static.sandbase.ai/examples/a91d9da4-241c-4080-a7ba-61d429dc5561/input/20fe7b20-b825-40c4-b777-b37f2a70589e.mp4"
        ]
      },
