{
  "name": "sandai/magi-2/image-to-video",
  "display_name": "MAGI-2 Image to Video",
  "type": "video",
  "vendor": "Sand AI",
  "vendor_slug": "sandai",
  "description": "MAGI-2 by Sand AI animates a first frame, or a first and last frame, into a 1080p video of 4 to 30 seconds with native audio.",
  "tags": [
    "image-to-video"
  ],
  "capabilities": [
    "image-to-video"
  ],
  "modes": [
    "async"
  ],
  "default_mode": "async",
  "endpoints": {
    "run": "POST /v1/run",
    "get_run": "GET /v1/run/{id}"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "image"
    ],
    "properties": {
      "seed": {
        "type": "integer",
        "title": "Seed",
        "maximum": 4294967295,
        "minimum": 0,
        "description": "Random seed for reproducibility (0-4294967295). Omit for a random seed."
      },
      "image": {
        "type": "string",
        "title": "First Frame",
        "description": "Public HTTPS URL of the first frame. JPEG, PNG, WebP, BMP, TIFF, GIF or HEIC, under 30 MB."
      },
      "prompt": {
        "type": "string",
        "title": "Prompt",
        "description": "Optional. Describe the motion and sound."
      },
      "duration": {
        "type": "integer",
        "title": "Duration",
        "default": 5,
        "maximum": 30,
        "minimum": 4,
        "examples": [
          5,
          10,
          30
        ],
        "description": "Output video duration in seconds (4-30). Billed per second."
      },
      "end_image": {
        "type": "string",
        "title": "Last Frame",
        "description": "Optional public HTTPS URL of the last frame."
      },
      "resolution": {
        "enum": [
          "1080p"
        ],
        "type": "string",
        "title": "Resolution",
        "default": "1080p",
        "description": "Output resolution. MAGI-2 renders 1080p only."
      },
      "aspect_ratio": {
        "enum": [
          "16:9",
          "9:16",
          "1:1",
          "4:3",
          "3:4",
          "21:9"
        ],
        "type": "string",
        "title": "Aspect Ratio",
        "default": "16:9",
        "description": "Output aspect ratio."
      },
      "generate_audio": {
        "type": "boolean",
        "title": "Generate Audio",
        "default": true,
        "description": "Generate a native audio track with the video. Included in the price."
      }
    }
  },
  "response_schema": {
    "type": "object",
    "title": "GenerationResponse",
    "required": [
      "id",
      "status"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier for the generation task."
      },
      "error": {
        "type": "string",
        "description": "Error message if the task failed. Empty on success."
      },
      "model": {
        "type": "string",
        "description": "Model ID used for the prediction."
      },
      "status": {
        "enum": [
          "pending",
          "running",
          "completed",
          "failed",
          "timeout"
        ],
        "type": "string",
        "description": "Status of the task: pending, running, completed, failed, or timeout."
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "title": "OutputItem",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "description": "The URL where the generated content can be downloaded from."
            },
            "content_type": {
              "type": "string",
              "description": "The MIME type of the output file."
            }
          }
        },
        "description": "Array of generated content. Empty when status is not completed."
      }
    }
  },
  "pricing": {
    "currency": "USD",
    "model": "formula",
    "formula": "(params.duration ?? 5) * 0.08",
    "formula_variables": [
      "params.duration"
    ],
    "reference_price": 0.4,
    "price_examples": [
      {
        "params": {
          "duration": 4
        },
        "usd": 0.32
      },
      {
        "params": {
          "duration": 5
        },
        "usd": 0.4
      },
      {
        "params": {
          "duration": 30
        },
        "usd": 2.4
      }
    ]
  },
  "examples": [
    {
      "input": {
        "aspect_ratio": "16:9",
        "duration": 5,
        "image": "https://static.sandbase.ai/examples/cf7d3354-3c3c-475c-93c0-74f31c6b084a/input/241be84a-97d7-4d77-9ca9-7fdb51507601.webp",
        "prompt": "The player jumps and shoots; the ball drops through the hoop and the friends on the court cheer. Handheld camera follows the shot."
      },
      "output": [
        {
          "url": "https://static.sandbase.ai/examples/cf7d3354-3c3c-475c-93c0-74f31c6b084a/output/5274b15a-f84f-4090-9f51-493760578f5d.mp4"
        }
      ],
      "default": true
    },
    {
      "input": {
        "aspect_ratio": "16:9",
        "duration": 5,
        "image": "https://static.sandbase.ai/examples/81388b0f-07c2-454c-b3d1-b5d1cc2a8680/input/3c3a70c5-90b9-4f03-bf17-b0258d1ac71d.webp",
        "prompt": "The jazz band starts playing; the camera slowly pushes in."
      },
      "output": [
        {
          "url": "https://static.sandbase.ai/examples/81388b0f-07c2-454c-b3d1-b5d1cc2a8680/output/dd756ccc-652e-487c-9703-c2d67ef59165.mp4"
        }
      ]
    }
  ],
  "cover_url": "https://static.sandbase.ai/blog/covers-v2/model-sandai-magi-2-image-to-video-0e231b8e57f2.webp",
  "page_url": "https://www.sandbase.ai/model/sandai/magi-2/image-to-video",
  "published_at": "2026-11-25T00:00:00Z",
  "created_at": "2026-11-25T04:03:12.353Z"
}
