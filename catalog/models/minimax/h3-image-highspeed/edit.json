{
  "name": "minimax/h3-image-highspeed/edit",
  "display_name": "MiniMax H3 Image Highspeed Edit",
  "type": "image",
  "vendor": "MiniMax",
  "vendor_slug": "minimax",
  "description": "MiniMax H3 Image Highspeed Edit is the faster version of MiniMax H3 Image Edit, editing and composing images from 1 to 16 reference images with the same parameters and 1K, 2K or 4K output.",
  "tags": [
    "image-to-image",
    "commercial"
  ],
  "capabilities": [
    "image-to-image",
    "commercial"
  ],
  "modes": [
    "async"
  ],
  "default_mode": "async",
  "endpoints": {
    "run": "POST /v1/run",
    "get_run": "GET /v1/run/{id}"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "prompt",
      "images"
    ],
    "properties": {
      "images": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "title": "Images",
        "examples": [
          "https://storage.googleapis.com/falserverless/example_inputs/dog.png"
        ],
        "maxItems": 16,
        "description": "URLs of 1 to 16 reference images to edit or combine (JPG, PNG, WEBP, HEIC or HEIF; 128 to 8192 px per side)."
      },
      "prompt": {
        "type": "string",
        "title": "Prompt",
        "default": "Put a red knitted scarf on the dog and keep everything else",
        "maxLength": 32000,
        "minLength": 1,
        "description": "The text prompt to generate an image from."
      },
      "resolution": {
        "enum": [
          "1K",
          "2K",
          "4K"
        ],
        "type": "string",
        "title": "Resolution",
        "default": "1K",
        "description": "Output resolution tier: 1K (about 1 MP), 2K (about 4 MP) or 4K (about 16 MP)."
      },
      "aspect_ratio": {
        "enum": [
          "21:9",
          "16:9",
          "2:1",
          "3:2",
          "4:3",
          "5:4",
          "1:1",
          "4:5",
          "3:4",
          "2:3",
          "1:2",
          "9:16",
          "9:21",
          "3:1",
          "1:3"
        ],
        "type": "string",
        "title": "Aspect Ratio",
        "description": "Output aspect ratio. Leave empty to let the model choose based on the reference images and instruction."
      },
      "output_format": {
        "enum": [
          "jpeg",
          "png",
          "webp"
        ],
        "type": "string",
        "title": "Output Format",
        "default": "png",
        "description": "The format of the generated image."
      }
    }
  },
  "response_schema": {
    "type": "object",
    "title": "GenerationResponse",
    "required": [
      "id",
      "status"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier for the generation task."
      },
      "error": {
        "type": "string",
        "description": "Error message if the task failed. Empty on success."
      },
      "model": {
        "type": "string",
        "description": "Model ID used for the prediction."
      },
      "status": {
        "enum": [
          "pending",
          "running",
          "completed",
          "failed",
          "timeout"
        ],
        "type": "string",
        "description": "Status of the task: pending, running, completed, failed, or timeout."
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "title": "OutputItem",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "examples": [
                "https://storage.googleapis.com/falserverless/example_outputs/nano-banana-multi-edit-output.png"
              ],
              "description": "The URL where the generated content can be downloaded from."
            },
            "content_type": {
              "type": "string",
              "description": "The MIME type of the output file."
            }
          }
        },
        "description": "Array of generated content. Empty when status is not completed."
      }
    }
  },
  "pricing": {
    "currency": "USD",
    "model": "formula",
    "formula": "((params.resolution ?? \"1K\") == \"4K\" ? 0.18 : 0.05) + 0.016 * len(params.images ?? [])",
    "formula_variables": [
      "params.images",
      "params.resolution"
    ],
    "reference_price": 0.066,
    "price_examples": [
      {
        "params": {
          "resolution": "1K"
        },
        "usd": 0.066
      },
      {
        "params": {
          "resolution": "2K"
        },
        "usd": 0.066
      },
      {
        "params": {
          "resolution": "4K"
        },
        "usd": 0.196
      }
    ]
  },
