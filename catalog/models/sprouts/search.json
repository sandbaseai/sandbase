  "endpoints": {
    "run": "POST /v1/run",
    "get_run": "GET /v1/run/{id}",
    "passthrough": "POST /v1/api/sprouts/search"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "query"
    ],
    "properties": {
      "page": {
        "type": "integer",
        "maximum": 100,
        "minimum": 1,
        "description": "One-based result page."
      },
      "query": {
        "type": "string",
        "example": "milk",
        "maxLength": 500,
        "minLength": 1,
        "description": "Product keywords to search for."
      },
      "timeout": {
        "type": "number",
        "default": 50,
        "maximum": 50,
        "description": "Seconds the data source may spend before giving up (max 50, default 50). A timed-out call is not billed.",
        "exclusiveMinimum": 0
      },
      "store_id": {
        "type": "string",
        "pattern": "^[0-9]{1,8}$",
        "maxLength": 8,
        "minLength": 1,
        "description": "Sprouts store location ID, such as 17650. Selects that store's in-store catalog."
      }
    }
  },
  "response_schema": {
    "type": "object",
