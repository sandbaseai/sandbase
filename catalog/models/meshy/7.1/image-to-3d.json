{
  "name": "meshy/7.1/image-to-3d",
  "display_name": "Meshy 7.1 Image to 3D",
  "type": "image",
  "vendor": "Meshy",
  "vendor_slug": "meshy",
  "description": "Meshy 7.1 turns a single image into a textured, optionally rigged and animated 3D model.",
  "tags": [
    "image-to-3d"
  ],
  "capabilities": [
    "image-to-3d"
  ],
  "modes": [
    "async"
  ],
  "default_mode": "async",
  "endpoints": {
    "run": "POST /v1/run",
    "get_run": "GET /v1/run/{id}"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "image"
    ],
    "properties": {
      "image": {
        "type": "string",
        "title": "Image",
        "description": "Image URL or base64 data URI for 3D model creation. Supports .jpg, .jpeg, and .png formats. Also supports AVIF and HEIF formats which will be automatically converted."
      },
      "topology": {
        "enum": [
          "quad",
          "triangle"
        ],
        "type": "string",
        "title": "Topology",
        "default": "triangle",
        "description": "quad for smooth surfaces, triangle for detail."
      },
      "pose_mode": {
        "enum": [
          "a-pose",
          "t-pose",
          ""
        ],
        "type": "string",
        "title": "Pose Mode",
        "default": "",
        "description": "a-pose, t-pose or empty for none."
      },
      "enable_pbr": {
        "type": "boolean",
        "title": "Enable PBR",
        "default": false,
        "description": "Generate PBR maps (metallic, roughness, normal)."
      },
      "model_type": {
        "enum": [
          "standard",
          "lowpoly",
          "smart-topology"
        ],
        "type": "string",
        "title": "Model Type",
        "default": "standard",
        "description": "standard, lowpoly or smart-topology."
      },
      "symmetry_mode": {
        "enum": [
          "off",
          "auto",
          "on"
        ],
        "type": "string",
        "title": "Symmetry Mode",
        "default": "auto",
        "description": "off / auto / on."
      },
      "texture_image": {
        "type": "string",
        "title": "Texture Image",
        "description": "Image URL to guide texturing."
      },
      "enable_rigging": {
        "type": "boolean",
        "title": "Auto Rigging",
        "default": false,
        "description": "Rig the model as a humanoid character (+$0.20)."
      },
      "should_texture": {
        "type": "boolean",
        "title": "Texture",
        "default": true,
        "description": "Generate textures (untextured models are cheaper)."
      },
      "texture_prompt": {
        "type": "string",
        "title": "Texture Prompt",
        "maxLength": 600,
        "description": "Text prompt to guide texturing."
      },
      "enable_animation": {
        "type": "boolean",
        "title": "Animation",
        "default": false,
        "description": "Apply an animation preset; requires enable_rigging (+$0.12)."
      },
      "target_polycount": {
        "type": "integer",
        "title": "Target Polycount",
        "default": 30000,
        "maximum": 300000,
        "minimum": 100,
        "description": "Target polygon count (100–300,000)."
      },
      "geometry_resolution": {
        "enum": [
          "standard",
          "2k",
          "4k"
        ],
        "type": "string",
        "title": "Geometry Resolution",
        "default": "standard",
        "description": "Geometry resolution."
      }
    }
  },
  "response_schema": {
    "type": "object",
    "title": "GenerationResponse",
    "required": [
      "id",
      "status"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier for the generation task."
      },
      "error": {
        "type": "string",
        "description": "Error message if the task failed. Empty on success."
      },
      "model": {
        "type": "string",
        "description": "Model ID used for the prediction."
      },
      "status": {
        "enum": [
          "pending",
          "running",
          "completed",
          "failed",
          "timeout"
        ],
        "type": "string",
        "description": "Status of the task: pending, running, completed, failed, or timeout."
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "title": "OutputItem",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "description": "The URL where the generated content can be downloaded from."
            },
            "content_type": {
              "type": "string",
              "description": "The MIME type of the output file."
            }
          }
        },
        "description": "Array of generated content. Empty when status is not completed."
      }
    }
  },
  "pricing": {
    "currency": "USD",
    "model": "formula",
    "formula": "((params.should_texture ?? true) ? 1.44 : 0.96) + ((params.geometry_resolution ?? \"standard\") == \"4k\" ? 0.48 : (params.geometry_resolution ?? \"standard\") == \"2k\" ? 0.24 : 0.0) + ((params.enable_rigging ?? false) ? 0.24 : 0.0) + ((params.enable_rigging ?? false) && (params.enable_animation ?? false) ? 0.144 : 0.0)",
