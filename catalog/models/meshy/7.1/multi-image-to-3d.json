{
  "name": "meshy/7.1/multi-image-to-3d",
  "display_name": "Meshy 7.1 Multi-Image to 3D",
  "type": "image",
  "vendor": "Meshy",
  "vendor_slug": "meshy",
  "description": "Meshy 7.1 reconstructs a textured, optionally rigged 3D model from 1–4 views of the same object.",
  "tags": [
    "image-to-3d"
  ],
  "capabilities": [
    "image-to-3d"
  ],
  "modes": [
    "async"
  ],
  "default_mode": "async",
  "endpoints": {
    "run": "POST /v1/run",
    "get_run": "GET /v1/run/{id}"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "images"
    ],
    "properties": {
      "images": {
        "type": "array",
        "items": {
          "type": "string",
          "_fal_ui_field": "image"
        },
        "title": "Images",
        "maxItems": 4,
        "minItems": 1,
        "description": "1 to 4 images of the same object from different angles."
      },
      "topology": {
        "enum": [
          "quad",
          "triangle"
        ],
        "type": "string",
        "title": "Topology",
        "default": "triangle",
        "description": "quad for smooth surfaces, triangle for detail."
      },
      "auto_size": {
        "type": "boolean",
        "title": "Auto Size",
        "default": false,
        "description": "Estimate the object's real-world height and scale the model to it. The origin goes to the bottom unless origin_at is set."
      },
      "origin_at": {
        "enum": [
          "bottom",
          "center"
        ],
        "type": "string",
        "title": "Origin",
        "description": "Where to place the model origin."
      },
      "pose_mode": {
        "enum": [
          "a-pose",
          "t-pose",
          ""
        ],
        "type": "string",
        "title": "Pose Mode",
        "default": "",
        "description": "a-pose, t-pose or empty for none."
      },
      "enable_pbr": {
        "type": "boolean",
        "title": "Enable PBR",
        "default": false,
        "description": "Generate PBR maps (metallic, roughness, normal)."
      },
      "symmetry_mode": {
        "enum": [
          "off",
          "auto",
          "on"
        ],
        "type": "string",
        "title": "Symmetry Mode",
        "default": "auto",
        "description": "off / auto / on."
      },
      "texture_image": {
        "type": "string",
        "title": "Texture Image",
        "description": "Image URL to guide texturing."
      },
      "texture_model": {
        "enum": [
          "meshy-n1"
        ],
        "type": "string",
        "title": "Texture Model",
        "description": "Texture model that paints the mesh; leave empty for the geometry model's default. meshy-n1 textures from the image only (no text prompt, no PBR, 2k only)."
      },
      "enable_rigging": {
        "type": "boolean",
        "title": "Auto Rigging",
        "default": false,
        "description": "Rig the model as a humanoid character (+$0.20)."
      },
      "should_texture": {
        "type": "boolean",
        "title": "Texture",
        "default": true,
        "description": "Generate textures (untextured models are cheaper)."
      },
      "texture_prompt": {
        "type": "string",
        "title": "Texture Prompt",
        "maxLength": 800,
        "description": "Text prompt to guide texturing."
      },
      "remove_lighting": {
        "type": "boolean",
        "title": "Remove Lighting",
        "description": "Remove baked highlights and shadows from the base color texture. Takes effect with the Meshy 6 texture model."
      },
      "enable_animation": {
        "type": "boolean",
        "title": "Animation",
        "default": false,
        "description": "Apply an animation preset; requires enable_rigging (+$0.12)."
      },
      "target_polycount": {
        "type": "integer",
        "title": "Target Polycount",
        "default": 30000,
        "maximum": 300000,
        "minimum": 100,
        "description": "Target polygon count (100–300,000)."
      },
      "image_enhancement": {
        "type": "boolean",
        "title": "Image Enhancement",
        "description": "Optimize the input image before generating; false keeps its exact look. Not supported by Meshy 6 Lite or Smart Topology."
      },
      "texture_image_urls": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "title": "Texture Images",
        "maxItems": 4,
        "description": "Several texture reference images (alternative to texture_image)."
      },
      "texture_resolution": {
        "enum": [
          "2k",
          "4k",
          "8k"
        ],
        "type": "string",
        "title": "Texture Resolution",
        "default": "2k",
        "description": "Base color texture resolution. 8k costs $0.20 more."
      },
      "geometry_resolution": {
        "enum": [
          "standard",
          "2k"
        ],
        "type": "string",
        "title": "Geometry Resolution",
        "default": "standard",
        "description": "Geometry resolution."
      }
    }
  },
  "response_schema": {
    "type": "object",
    "title": "GenerationResponse",
    "required": [
      "id",
      "status"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier for the generation task."
      },
      "error": {
        "type": "string",
        "description": "Error message if the task failed. Empty on success."
      },
      "model": {
        "type": "string",
        "description": "Model ID used for the prediction."
      },
      "status": {
        "enum": [
          "pending",
          "running",
          "completed",
          "failed",
          "timeout"
        ],
        "type": "string",
        "description": "Status of the task: pending, running, completed, failed, or timeout."
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "title": "OutputItem",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "description": "The URL where the generated content can be downloaded from."
            },
            "content_type": {
              "type": "string",
              "description": "The MIME type of the output file."
            }
          }
        },
        "description": "Array of generated content. Empty when status is not completed."
      }
    }
  },
