        "default": "fast",
        "description": "Generation speed."
      },
      "prompt": {
        "type": "string",
        "title": "Prompt",
        "maxLength": 1024,
        "minLength": 1,
        "description": "Text prompt used to generate the image."
      },
      "quality": {
        "enum": [
          "standard",
          "hd"
        ],
        "type": "string",
        "title": "Quality",
        "default": "standard",
        "description": "Output quality. HD is unavailable with draft speed."
