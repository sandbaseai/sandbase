{
  "name": "vaquill/divisions",
  "display_name": "Vaquill Divisions",
  "type": "api",
  "vendor": "Vaquill",
  "vendor_slug": "vaquill",
  "description": "Walk a US legal code level by level: titles, chapters, parts, then sections.",
  "tags": [
    "api",
    "vaquill",
    "legal-research"
  ],
  "capabilities": [
    "api",
    "vaquill",
    "legal-research"
  ],
  "modes": [
    "async"
  ],
  "default_mode": "async",
  "endpoints": {
    "run": "POST /v1/run",
    "get_run": "GET /v1/run/{id}",
    "passthrough": "POST /v1/api/vaquill/divisions"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "corpusType"
    ],
    "properties": {
      "code": {
        "type": "string",
        "minLength": 1,
        "description": "State code identifier to drill into, e.g. 'tx_pe' — the identifier returned by browsing corpusType=STATE with a state."
      },
      "part": {
        "type": "string",
        "minLength": 1,
        "description": "Part identifier to drill into (CFR)."
      },
      "state": {
        "enum": [
          "al",
          "ak",
          "az",
          "ar",
          "ca",
          "co",
          "ct",
          "de",
          "dc",
          "fl",
          "ga",
          "hi",
          "id",
          "il",
          "in",
          "ia",
          "ks",
          "ky",
          "la",
          "me",
          "md",
          "ma",
          "mi",
          "mn",
          "ms",
          "mo",
          "mt",
          "ne",
          "nv",
          "nh",
          "nj",
          "nm",
          "ny",
          "nc",
          "nd",
          "oh",
          "ok",
          "or",
          "pa",
          "pr",
          "ri",
          "sc",
          "sd",
          "tn",
          "tx",
          "ut",
          "vt",
          "va",
          "wa",
          "wv",
          "wi",
          "wy"
        ],
        "type": "string",
        "description": "Lowercase two-letter jurisdiction code, e.g. 'tx'; required for STATE and REGULATION."
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "description": "Resume token from a previous response's nextCursor, at the level that lists sections."
      },
      "chapter": {
        "type": "string",
        "minLength": 1,
        "description": "Chapter identifier to drill into (USC and state codes)."
      },
      "actStatus": {
        "enum": [
          "abolished",
          "deleted",
          "expired",
          "in_force",
          "inactive",
          "non_precedential",
          "not_funded",
          "not_yet_effective",
          "omitted",
          "proposed",
          "recodified",
          "recompiled",
          "rejected",
          "relocated",
          "removed",
          "renumbered",
          "repealed",
          "rescinded",
          "reserved",
          "revoked",
          "superseded",
          "terminated",
          "transferred",
          "unconstitutional",
          "vacant",
          "vacated",
          "vetoed",
          "withdrawn"
        ],
        "type": "string",
        "description": "List only sections carrying this status, e.g. 'repealed'."
      },
      "corpusType": {
        "enum": [
          "USC",
          "CFR",
          "STATE",
          "REGULATION"
        ],
        "type": "string",
        "example": "USC",
        "description": "Corpus to browse. Other corpora are flatter — search them instead."
      },
      "titleNumber": {
        "type": "integer",
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "description": "USC or CFR title number to drill into."
      },
      "excludeRepealed": {
        "type": "boolean",
        "description": "Leave out sections whose status is affirmatively dead. A section with no recorded status is kept."
      }
    }
  },
  "response_schema": {
    "type": "object",
    "required": [
