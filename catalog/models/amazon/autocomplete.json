{
  "name": "amazon/autocomplete",
  "display_name": "Amazon Search Suggestions",
  "type": "api",
  "vendor": "Amazon",
  "vendor_slug": "amazon",
  "description": "Get Amazon search box suggestions for a partial keyword, optionally for a specific Amazon domain and department.",
  "tags": [
    "api",
    "amazon",
    "ecommerce",
    "keywords"
  ],
  "capabilities": [
    "api",
    "amazon",
    "ecommerce",
    "keywords"
  ],
  "modes": [
    "async"
  ],
  "default_mode": "async",
  "endpoints": {
    "run": "POST /v1/run",
    "get_run": "GET /v1/run/{id}",
    "passthrough": "POST /v1/api/amazon/autocomplete"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "k"
    ],
    "properties": {
      "k": {
        "type": "string",
        "example": "iphone ca",
        "minLength": 1,
        "description": "Partial search text to complete."
      },
      "timeout": {
        "type": "number",
        "default": 50,
        "maximum": 50,
        "description": "Seconds the data source may spend before giving up (max 50, default 50). A timed-out call is not billed.",
        "exclusiveMinimum": 0
      },
      "amazon_domain": {
        "type": "string",
        "description": "Amazon storefront hostname."
      },
      "amazon_department": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]+$",
        "minLength": 1,
        "description": "Department alias used to narrow suggestions; aps searches all departments."
      }
    }
  },
  "response_schema": {
    "type": "object",
    "required": [
      "id",
      "status",
      "model"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "model": {
        "type": "string"
      },
      "status": {
        "type": "string"
      }
    }
  },
  "pricing": {
    "currency": "USD",
    "model": "per_call",
    "per_call": 0.00015
  },
  "readme": "# Amazon Search Suggestions\n\nGet Amazon search box suggestions for a partial keyword, optionally for a specific Amazon domain and department.",
  "page_url": "https://www.sandbase.ai/model/amazon/autocomplete",
