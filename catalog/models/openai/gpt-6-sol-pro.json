    "chat",
    "vision",
    "reasoning",
    "structured_output",
    "function_calling"
  ],
  "modes": [
    "sync"
  ],
  "default_mode": "sync",
  "endpoints": {
    "chat_completions": "POST /v1/chat/completions",
    "responses": "POST /v1/responses",
    "messages": "POST /v1/messages"
  },
  "pricing": {
    "currency": "USD",
    "model": "per_token",
    "per_million_tokens": {
      "input": 2,
      "output": 10,
      "cache_read_multiplier": 0.1,
      "cache_write_multiplier": 1.25
    },
    "formula": "usage.prompt_tokens >= 272000 ? (usage.prompt_tokens * 4 / 1000000 + usage.completion_tokens * 15 / 1000000 - usage.cached_tokens * 1.8 / 1000000 + usage.cache_creation_tokens * 0.5 / 1000000) : (usage.prompt_tokens * 2 / 1000000 + usage.completion_tokens * 10 / 1000000)",
    "formula_variables": [
      "usage.cache_creation_tokens",
      "usage.cached_tokens",
      "usage.completion_tokens",
      "usage.prompt_tokens"
    ]
  },
