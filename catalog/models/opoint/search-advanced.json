{
  "name": "opoint/search-advanced",
  "display_name": "Opoint Search Advanced",
  "type": "api",
  "vendor": "Opoint",
  "vendor_slug": "opoint",
  "description": "Search news with structured expression lines and typed filter ids.",
  "tags": [
    "api",
    "opoint",
    "news-search"
  ],
  "capabilities": [
    "api",
    "opoint",
    "news-search"
  ],
  "modes": [
    "async"
  ],
  "default_mode": "async",
  "endpoints": {
    "run": "POST /v1/run",
    "get_run": "GET /v1/run/{id}",
    "passthrough": "POST /v1/api/opoint/search-advanced"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "expressions"
    ],
    "properties": {
      "params": {
        "type": "object",
        "properties": {
          "newest": {
            "type": "integer",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "description": "Unix seconds; only articles published at or before this time."
          },
          "oldest": {
            "type": "integer",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "description": "Unix seconds; only articles published at or after this time."
          },
          "context": {
            "type": "string",
            "maxLength": 200,
            "description": "Pagination cursor from the previous response's context field; resend the same search to get the next page."
          },
          "excludearticles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id_site",
                "id_article"
              ],
              "properties": {
                "id_site": {
                  "type": "integer",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "description": "Opoint site id."
                },
                "id_article": {
                  "type": "integer",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "description": "Article id, unique within the site."
                }
              },
              "additionalProperties": false
            },
            "maxItems": 100,
            "description": "Site/article id pairs to leave out of the results."
          },
          "requestedarticles": {
            "type": "integer",
            "maximum": 100,
            "minimum": 1,
            "description": "Articles to return (1-100, default 10)."
          },
          "sort_oldest_first": {
            "type": "boolean",
            "description": "Oldest first instead of newest first."
          }
        },
        "additionalProperties": false
      },
      "expressions": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "linemode",
            "searchline"
          ],
          "properties": {
            "linemode": {
              "enum": [
                "R",
                "O",
                "E"
              ],
              "type": "string",
              "description": "R = required, O = optional, E = exclude this line."
            },
            "searchline": {
              "type": "object",
              "required": [
                "searchterm"
              ],
              "properties": {
                "filters": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "type",
                      "id"
                    ],
                    "properties": {
                      "id": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "integer",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991
                          }
                        ],
                        "description": "Filter id from /suggest (geo: 1203) or a literal (lang: 'en', url: 'bbc.co.uk')."
                      },
                      "type": {
                        "enum": [
                          "lang",
                          "geo",
                          "site",
                          "media",
                          "content",
                          "subject",
                          "ent",
                          "topic",
                          "url",
                          "domain"
                        ],
                        "type": "string",
                        "description": "Filter type, as returned by /suggest."
                      }
                    },
                    "additionalProperties": false
                  },
                  "maxItems": 20,
                  "description": "Structured filters ANDed onto the searchterm."
                },
                "searchterm": {
                  "type": "string",
                  "maxLength": 2000,
                  "minLength": 1,
                  "description": "Opoint search expression: keywords and 'quoted phrases', section prefixes (header:, summary:, body:, author:, url:), wildcards (spot*), proximity ('Trump Biden'~5), boolean AND / OR / ANDNOT, and filter ids from /suggest (lang:en, geo:1203, site:318, media:576). Example: \"header:spotify AND lang:en\"."
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "example": [
          {
            "linemode": "R",
            "searchline": {
              "searchterm": "header:spotify AND lang:en"
            }
          }
        ],
        "maxItems": 10,
        "minItems": 1,
        "description": "One or more search lines; R lines must all match."
      }
    }
  },
  "response_schema": {
    "type": "object",
    "required": [
      "id",
      "status",
      "model"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "model": {
        "type": "string"
      },
      "status": {
        "type": "string"
      }
    }
  },
  "pricing": {
    "currency": "USD",
    "model": "per_call",
    "per_call": 0.06
  },
  "readme": "# Opoint Search Advanced\n\nSearch news with structured expression lines and typed filter ids.",
  "page_url": "https://www.sandbase.ai/model/opoint/search-advanced",
  "created_at": "2026-11-15T01:25:45.703Z"
}
